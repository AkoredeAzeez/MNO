{
    "kind": "collectionType",
    "collectionName": "gallery_albums",
    "info": {
        "singularName": "gallery-album",
        "pluralName": "gallery-albums",
        "displayName": "Gallery Album",
        "description": "A collection of photos grouped under one event or theme"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "title": {
            "type": "string",
            "required": true
        },
        "slug": {
            "type": "uid",
            "targetField": "title",
            "required": true
        },
        "description": {
            "type": "text"
        },
        "eventDate": {
            "type": "date"
        },
        "coverImage": {
            "type": "media",
            "multiple": false,
            "allowedTypes": [
                "images"
            ],
            "required": false
        },
        "photos": {
            "type": "media",
            "multiple": true,
            "allowedTypes": [
                "images"
            ],
            "required": false
        },
        "photographer": {
            "type": "string"
        },
        "order": {
            "type": "integer",
            "default": 0
        },
        "event": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::event.event",
            "inversedBy": "galleryAlbums"
        }
    }
}
