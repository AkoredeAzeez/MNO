# Frontend environment variables (Next.js)
# Copy to .env.local and fill in real values.

# Paystack (donations). Get a public test/live key from https://dashboard.paystack.com
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Strapi backend URL.
# NEXT_PUBLIC_ prefix is required: the browser fetches Strapi directly, and
# Next.js only inlines NEXT_PUBLIC_* variables into the client bundle.
NEXT_PUBLIC_STRAPI_BASE_URL=http://localhost:1337
